# Solo para desarrollo fuera de Docker. En el servidor la configuración llega
# por variables de entorno desde compose.yaml y el .env de la raíz del repo.
APP_NAME=jolo-PM
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/jolo-pm.sqlite   (por defecto database/database.sqlite)

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

GITHUB_TOKEN=
SYNC_CRON="*/5 * * * *"
BLOB_TTL_DAYS=30
