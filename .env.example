# Copia este fichero a `.env` y ajusta los valores:  cp .env.example .env

# Token de GitHub de SOLO LECTURA. Recomendado: fine-grained token
# (Settings → Developer settings → Fine-grained tokens) con acceso a los repos
# que quieras seguir y permisos de solo lectura en:
#   Contents, Pull requests y Metadata.
# Es la única variable obligatoria: sin ella el compose no arranca.
GITHUB_TOKEN=

# Cada cuánto se sincronizan todos los proyectos (expresión cron).
#SYNC_CRON=*/5 * * * *

# Dónde se guarda la base de datos SQLite. Por defecto ./data, junto al compose.
#JOLOPM_DATA_DIR=./data

# Puerto local de la web (solo escucha en 127.0.0.1).
#JOLOPM_PORT=8095

# uid/gid con el que corre el backend, para que la base de datos sea tuya.
#PUID=1000
#PGID=1000

#TZ=Europe/Madrid
