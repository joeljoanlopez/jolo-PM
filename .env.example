# Copia este fichero a `.env` y ajusta los valores:  cp .env.example .env

# Token de GitHub de SOLO LECTURA. Recomendado: fine-grained token
# (Settings → Developer settings → Fine-grained tokens) con acceso a los repos
# que quieras seguir y permisos de solo lectura en:
#   Contents, Pull requests y Metadata.
GITHUB_TOKEN=

# Clave de cifrado de la app: cookies, sesión y secreto del 2FA. Genérala una
# vez y no la cambies (si cambia, hay que rehacer la cuenta con auth:reset):
#   sed -i "s|^APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32)|" .env
# GITHUB_TOKEN y APP_KEY son obligatorias: sin ellas el compose no arranca.
APP_KEY=

# Minutos sin usar la web tras los que caduca la sesión (7 días por defecto).
#SESSION_LIFETIME=10080

# La cookie de sesión solo viaja por HTTPS. Pon false solo si entras por HTTP
# desde otra máquina (sin proxy con HTTPS): si no, el login no se mantiene.
#SESSION_SECURE_COOKIE=true

# De quién se acepta X-Forwarded-For para saber la IP real del cliente (límite
# de intentos del login). REMOTE_ADDR = de quien conecta a la web, que es tu
# proxy inverso (la web solo escucha en 127.0.0.1). Ver el README.
#TRUSTED_PROXIES=REMOTE_ADDR

# Cada cuánto se sincronizan todos los proyectos (expresión cron).
#SYNC_CRON=*/5 * * * *

# Dónde se guarda la base de datos SQLite. Por defecto ./data, junto al compose.
#JOLOPM_DATA_DIR=./data

# Puerto local de la web (solo escucha en 127.0.0.1).
#JOLOPM_PORT=8095

# uid/gid con el que corre el backend, para que la base de datos sea tuya.
#PUID=1000
#PGID=1000

#TZ=Europe/Madrid

# Despliegue automático (opcional): con `true`, el timer de deploy/ trae cada
# commit nuevo de origin/main con el CI en verde y reconstruye los contenedores.
# Cualquier otro valor, o no definirla, lo deja desactivado. Ver el README.
AUTO_DEPLOY=false
